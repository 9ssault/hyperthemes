// Generated by HyperThemes.
// Zellij loads this from ~/.config/zellij/themes/hyperthemes.kdl when
// config.kdl contains: theme "hyperthemes"

themes {
    hyperthemes {
        fg "#{{onBackground}}"
        bg "#{{background}}"
        black "#{{term0}}"
        red "#{{term1}}"
        green "#{{term2}}"
        yellow "#{{term3}}"
        blue "#{{term4}}"
        magenta "#{{term5}}"
        cyan "#{{term6}}"
        white "#{{term7}}"
        orange "#{{tertiary}}"
        ribbon_selected_bg "#{{primary}}"
        ribbon_selected_fg "#{{onPrimary}}"
        ribbon_unselected_bg "#{{surfaceContainerHigh}}"
        ribbon_unselected_fg "#{{onSurface}}"
        table_title_bg "#{{surfaceContainerHigh}}"
        table_title_fg "#{{primary}}"
        table_bg "#{{surfaceContainer}}"
    }
}

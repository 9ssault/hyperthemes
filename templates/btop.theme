theme[free_end]="#{{term4}}"
theme[cached_start]="#{{term4}}"
theme[cached_mid]="#{{term5}}"
theme[cached_end]="#{{term6}}"
theme[available_start]="#{{term3}}"
theme[available_mid]="#{{term2}}"
theme[available_end]="#{{term1}}"
theme[used_start]="#{{term1}}"

# Generated by HyperThemes.
# btop reads this from ~/.config/btop/themes/hyperthemes.theme once
# btop.conf contains: color_theme = "hyperthemes"

theme[main_bg]="#{{background}}"
theme[main_fg]="#{{onBackground}}"
theme[title]="#{{onBackground}}"
theme[hi_fg]="#{{primary}}"
theme[selected_bg]="#{{surfaceContainerHigh}}"
theme[selected_fg]="#{{onSurface}}"
theme[inactive_fg]="#{{outline}}"
theme[proc_misc]="#{{secondary}}"
theme[cpu_box]="#{{primary}}"
theme[mem_box]="#{{secondary}}"
theme[net_box]="#{{tertiary}}"
theme[proc_box]="#{{primary}}"
theme[div_line]="#{{outline}}"
theme[temp_start]="#{{term2}}"
theme[temp_mid]="#{{term3}}"
theme[temp_end]="#{{error}}"
theme[cpu_start]="#{{term2}}"
theme[cpu_mid]="#{{term3}}"
theme[cpu_end]="#{{error}}"
theme[free_start]="#{{term3}}"
